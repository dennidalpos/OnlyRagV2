# This repository does not load .env files automatically. Set only the values
# you need in the process environment before starting Electron or the sidecar.
# Do not place credentials or tokens in this file.

# Directory used by the FastAPI sidecar for LanceDB data and generated exports.
# ONLYRAG_DATA_DIR=C:\\OnlyRagData

# Ollama HTTP endpoint used by the Python sidecar.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ingestion safety limits for CSV and Excel files.
# ONLYRAG_TABULAR_MAX_ROWS=300
# ONLYRAG_EXCEL_MAX_ROWS_PER_SHEET=150
# ONLYRAG_EXCEL_MAX_SHEETS=10

# Optional Ollama model storage override used by Electron diagnostics.
# OLLAMA_MODELS=C:\\Users\\<user>\\.ollama\\models
