{
  "name": "onlyrag-v2",
  "version": "1.0.0",
  "description": "Privacy-First Local AI Workspace App with Ollama, Vision OCR, Document RAG, Translation & Coding Agent",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --reporter=dot",
    "test:unit": "vitest run",
    "test:unit-only": "vitest run --reporter=dot electron/core/domain electron/core/application",
    "test:agent": "vitest run --reporter=dot electron/core/domain/agent",
    "test:skills": "vitest run --reporter=dot electron/core/domain/skills",
    "test:sidecar": "powershell -ExecutionPolicy Bypass -File ./scripts/test_sidecar_health.ps1 -Fast",
    "lint": "powershell -ExecutionPolicy Bypass -File ./scripts/lint_format.ps1 -Fast",
    "clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode Repo",
    "clean:full": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode Full",
    "package:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build_package.ps1"
  },
  "keywords": [],
  "author": "Danny Perondi <https://github.com/dennidalpos>",
  "license": "MIT",
  "dependencies": {
    "@types/diff": "^7.0.2",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "diff": "^9.0.0",
    "fast-levenshtein": "^3.0.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jsonrepair": "^3.15.0",
    "node-pty": "^1.1.0",
    "p-queue": "^9.3.3",
    "p-retry": "^8.0.0",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.7",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "gpt-tokenizer": "^4.0.0",
    "happy-dom": "^20.11.2",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.onlyrag.v2",
    "productName": "OnlyRag V2",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!tests/**"
        ]
      },
      {
        "from": "sidecar_dist/sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OnlyRag V2",
      "uninstallDisplayName": "OnlyRag V2 Local AI Workspace",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    }
  }
}
