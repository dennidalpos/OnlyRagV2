{
  "name": "onlyrag-v2",
  "version": "1.0.0",
  "description": "Privacy-First Local AI Workspace App with Ollama, Vision OCR, Document RAG, Translation & Coding Agent",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --reporter=dot",
    "test:unit": "vitest run",
    "test:unit-only": "vitest run --reporter=dot electron/core/domain electron/core/application",
    "test:sidecar": "powershell -ExecutionPolicy Bypass -File ./scripts/test_sidecar_health.ps1 -Fast",
    "lint": "powershell -ExecutionPolicy Bypass -File ./scripts/lint_format.ps1 -Fast",
    "clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode Repo",
    "clean:full": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode Full",
    "package:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build_package.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.0.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.onlyrag.v2",
    "productName": "OnlyRag V2",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "sidecar_dist/sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OnlyRag V2",
      "uninstallDisplayName": "OnlyRag V2 Local AI Workspace",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true
    }
  }
}
