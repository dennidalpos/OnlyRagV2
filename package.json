{
  "name": "onlyrag-v2",
  "version": "1.0.0",
  "description": "Privacy-First Local AI Workspace App with Ollama, Vision OCR, Document RAG, Translation & Coding Agent",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "setup:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/setup_dev_environment.ps1",
    "format:check": "git diff --check HEAD",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:fast": "vitest run --reporter=dot",
    "test:unit": "vitest run",
    "test:unit-only": "vitest run --reporter=dot electron/core/domain electron/core/application",
    "test:agent": "vitest run --reporter=dot electron/core/domain/agent",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:skills": "vitest run --reporter=dot electron/core/domain/skills",
    "test:sidecar": "powershell -ExecutionPolicy Bypass -File ./scripts/test_sidecar_health.ps1 -Fast",
    "test:smoke": "powershell -ExecutionPolicy Bypass -File ./scripts/test_bundle_smoke.ps1 -Fast",
    "lint": "powershell -ExecutionPolicy Bypass -File ./scripts/lint_format.ps1 -Fast",
    "clean": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_repo.ps1",
    "clean:logs": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode Logs",
    "clean:user": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode UserData",
    "clean:full": "powershell -ExecutionPolicy Bypass -File ./scripts/clean_workspace.ps1 -Mode Full",
    "package:win": "powershell -ExecutionPolicy Bypass -File ./scripts/build_package.ps1",
    "audit:cycles": "dpdm --circular --warning=false src/main.tsx electron/main.ts",
    "audit:deadcode": "knip",
    "audit:graph": "skott --displayMode=webapp",
    "audit:all": "powershell -ExecutionPolicy Bypass -File ./scripts/audit_codebase.ps1 -Fast"
  },
  "keywords": [],
  "author": "Danny Perondi <https://github.com/dennidalpos>",
  "license": "MIT",
  "engines": {
    "node": ">=22 <26",
    "npm": ">=10"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "depcheck": "^1.4.7",
    "diff": "^9.0.0",
    "fast-levenshtein": "^3.0.0",
    "js-yaml": "^4.1.0",
    "jsonrepair": "^3.15.0",
    "mustache": "^4.2.0",
    "node-pty": "^1.1.0",
    "p-queue": "^9.3.3",
    "semver": "^7.8.5",
    "strip-ansi": "^7.2.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "dompurify": "^3.4.13"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.7",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/diff": "^7.0.2",
    "@types/fast-levenshtein": "^0.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/semver": "^7.8.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.5",
    "dpdm": "^4.3.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "gpt-tokenizer": "^4.0.0",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.3",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skott": "^0.35.11",
    "tailwindcss": "^4.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.onlyrag.v2",
    "productName": "OnlyRag V2",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": "sidecar",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!tests/**"
        ]
      },
      {
        "from": "sidecar_dist/sidecar",
        "to": "sidecar",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OnlyRag V2",
      "uninstallDisplayName": "OnlyRag V2 Local AI Workspace",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "include": "installer/installer.nsh"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "electron-winstaller@5.4.0": true,
    "node-pty@1.1.0": true,
    "electron@43.4.1": true
  }
}
